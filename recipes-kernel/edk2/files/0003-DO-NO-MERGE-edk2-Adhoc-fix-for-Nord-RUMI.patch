From 2443ab232cd5bc1e9f26c3b378d8447cd547a1ca Mon Sep 17 00:00:00 2001
From: Yadu MG <quic_ymg@quicinc.com>
Date: Mon, 5 Aug 2024 15:22:09 +0530
Subject: [PATCH 3/3] [DO NO MERGE]: edk2: Adhoc fix for Nord RUMI

Adhoc fix to boot the ABL for Nord.

Change-Id: I94b2c700d464d8984d5df3708c13aeff1890927e
Signed-off-by: Yadu MG <quic_ymg@quicinc.com>
---
 QcomModulePkg/Library/BootLib/UpdateDeviceTree.c |  3 ++-
 QcomModulePkg/Library/FastbootLib/FastbootCmds.c |  3 ++-
 makefile                                         | 10 +++++-----
 3 files changed, 9 insertions(+), 7 deletions(-)

diff --git a/QcomModulePkg/Library/BootLib/UpdateDeviceTree.c b/QcomModulePkg/Library/BootLib/UpdateDeviceTree.c
index ff418813b2..3dbc8d0024 100755
--- a/QcomModulePkg/Library/BootLib/UpdateDeviceTree.c
+++ b/QcomModulePkg/Library/BootLib/UpdateDeviceTree.c
@@ -952,6 +952,7 @@ AddDDrRegion (VOID *Fdt)
 
   Status = GetDDrRegionsInfo (DdrRegionsDataInfo);
   if (Status != EFI_SUCCESS) {
+    DEBUG ((EFI_D_ERROR, "DDR regions Buffer: GetDDrRegionsInfo Failed\n"));
     return Status;
   }
 
@@ -1258,7 +1259,7 @@ OutofUpdateRankChannel:
           Status != EFI_UNSUPPORTED) {
         DEBUG ((EFI_D_ERROR,
                 "Failed to update DDR regions info, Status=%r\n", Status));
-        return Status;
+//        return Status;
       }
       DEBUG ((EFI_D_VERBOSE, "End DT ddr regions update: %lu ms\n",
                            GetTimerCountms ()));
diff --git a/QcomModulePkg/Library/FastbootLib/FastbootCmds.c b/QcomModulePkg/Library/FastbootLib/FastbootCmds.c
index 370b7450f2..20c1a09a96 100755
--- a/QcomModulePkg/Library/FastbootLib/FastbootCmds.c
+++ b/QcomModulePkg/Library/FastbootLib/FastbootCmds.c
@@ -2925,7 +2925,8 @@ CmdBoot (CONST CHAR8 *Arg, VOID *Data, UINT32 Size)
   Info.Images[0].ImageSize = Size;
   Info.Images[0].Name = "boot";
   Info.NumLoadedImages = 1;
-  Info.MultiSlotBoot = PartitionHasMultiSlot (L"boot");
+//  Info.MultiSlotBoot = PartitionHasMultiSlot (L"boot");
+  Info.MultiSlotBoot = TRUE;
 
   if (Info.MultiSlotBoot) {
     Status = ClearUnbootable ();
diff --git a/makefile b/makefile
index ed8d458ccf..86a357f571 100644
--- a/makefile
+++ b/makefile
@@ -6,7 +6,7 @@ export SIGN_ABL_IMAGE := ${SIGN_ABL_IMAGE}
 ifeq ($(BUILD_NATIVE_AARCH64),true)
 	export VERIFIED_BOOT := 0
 	export VERIFIED_BOOT_LE := false
-	export LOAD_KM_AND_SET_ROT := true
+	export LOAD_KM_AND_SET_ROT := false
 	export ENABLE_LE_VARIANT := false
 	export VERITY_LE := false
 	export DEFAULT_UNLOCK := true
@@ -215,25 +215,25 @@ else
 endif
 
 ifeq ($(EARLY_ETH_ENABLED), 1)
-	EARLY_ETH_ENABLED := 1
+	EARLY_ETH_ENABLED := 0
 else
 	EARLY_ETH_ENABLED := 0
 endif
 
 ifeq ($(ENABLE_SAIL_FLASHING), 1)
-        ENABLE_SAIL_FLASHING := 1
+        ENABLE_SAIL_FLASHING := 0
 else
         ENABLE_SAIL_FLASHING := 0
 endif
 
 ifeq ($(ENABLE_SAIL_BOOT), 1)
-        ENABLE_SAIL_BOOT := 1
+        ENABLE_SAIL_BOOT := 0
 else
         ENABLE_SAIL_BOOT := 0
 endif
 
 ifeq ($(EARLY_ETH_AS_DLKM), 1)
-	EARLY_ETH_AS_DLKM := 1
+	EARLY_ETH_AS_DLKM := 0
 else
 	EARLY_ETH_AS_DLKM := 0
 endif
