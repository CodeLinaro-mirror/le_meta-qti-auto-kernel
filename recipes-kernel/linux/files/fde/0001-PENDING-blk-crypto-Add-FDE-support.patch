 }
 
diff --git a/block/blk-crypto-internal.h b/block/blk-crypto-internal.h
index ccf6dff6ff6b..91b6e33f3e82 100644
--- a/block/blk-crypto-internal.h
+++ b/block/blk-crypto-internal.h
@@ -61,9 +61,10 @@ static inline void blk_crypto_rq_set_defaults(struct request *rq)
 	rq->crypt_keyslot = NULL;
 }
 
+static inline int is_full_crypto_enabled(struct request *rq);
 static inline bool blk_crypto_rq_is_encrypted(struct request *rq)
 {
-	return rq->crypt_ctx;
+	return rq->crypt_ctx || is_full_crypto_enabled(rq);
 }
 
 static inline bool blk_crypto_rq_has_keyslot(struct request *rq)
@@ -86,6 +87,30 @@ bool __blk_crypto_cfg_supported(struct blk_crypto_profile *profile,
 int blk_crypto_ioctl(struct block_device *bdev, unsigned int cmd,
 		     void __user *argp);
 
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+int blk_crypto_add_blk_key(struct blk_crypto_profile *profile,
+		const struct blk_crypto_key *key, const u8 *id, const u32 id_size);
+
+int blk_crypto_remove_blk_key(struct blk_crypto_profile *profile,
+			const struct blk_crypto_key *key);
+
+struct blk_crypto_key *blk_crypto_find_blk_key(
+					struct blk_crypto_profile *profile,
+					const u8 *id, const u32 id_size);
+
+static inline int is_full_crypto_enabled(struct request *rq)
+{
+	if (!rq || !rq->part)
+		return false;
+
+	return atomic_read(&rq->part->crypto_enabled) != 0;
+}
+#else /* CONFIG_QCOM_CRYPTO_FDE */
+static inline int is_full_crypto_enabled(struct request *rq)
+{
+	return false;
+}
+#endif /* CONFIG_QCOM_CRYPTO_FDE */
 #else /* CONFIG_BLK_INLINE_ENCRYPTION */
 
 static inline int blk_crypto_sysfs_register(struct gendisk *disk)
diff --git a/block/blk-crypto-profile.c b/block/blk-crypto-profile.c
index 170858af4ea2..910c1b245997 100644
--- a/block/blk-crypto-profile.c
+++ b/block/blk-crypto-profile.c
@@ -27,6 +27,9 @@
 #include <linux/blk-crypto-profile.h>
 #include <linux/device.h>
 #include <linux/atomic.h>
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+#include <linux/jhash.h>
+#endif
 #include <linux/mutex.h>
 #include <linux/pm_runtime.h>
 #include <linux/wait.h>
@@ -127,6 +130,20 @@ int blk_crypto_profile_init(struct blk_crypto_profile *profile,
 		goto err_destroy;
 	for (i = 0; i < slot_hashtable_size; i++)
 		INIT_HLIST_HEAD(&profile->slot_hashtable[i]);
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+	mutex_init(&profile->key_mutex);
+	/*
+	 * The number of keys shouldn't exceed that of the keyslot. So
+	 * use slot_hashtable_size to initialize key_hashtable here.
+	 */
+	profile->key_hashtable =
+		kvmalloc_array(slot_hashtable_size,
+				sizeof(profile->key_hashtable[0]), GFP_KERNEL);
+	if (!profile->key_hashtable)
+		goto err_destroy;
+	for (i = 0; i < slot_hashtable_size; i++)
+		INIT_HLIST_HEAD(&profile->key_hashtable[i]);
+#endif /* CONFIG_QCOM_CRYPTO_FDE */
 
 	return 0;
 
@@ -167,6 +184,18 @@ int devm_blk_crypto_profile_init(struct device *dev,
 }
 EXPORT_SYMBOL_GPL(devm_blk_crypto_profile_init);
 
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+static inline struct hlist_head *
+blk_crypto_hash_bucket_for_id(struct blk_crypto_profile *profile,
+			       const u8 *key_id, const u32 id_size)
+{
+	u32 hash_value = jhash(key_id, id_size, id_size);
+
+	return &profile->key_hashtable[
+			hash_long(hash_value, profile->log_slot_ht_size)];
+}
+#endif /* CONFIG_QCOM_CRYPTO_FDE */
+
 static inline struct hlist_head *
 blk_crypto_hash_bucket_for_key(struct blk_crypto_profile *profile,
 			       const struct blk_crypto_key *key)
@@ -217,6 +246,60 @@ blk_crypto_find_and_grab_keyslot(struct blk_crypto_profile *profile,
 	return slot;
 }
 
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+int blk_crypto_add_blk_key(struct blk_crypto_profile *profile,
+			const struct blk_crypto_key *key, const u8 *id, const u32 id_size)
+{
+	if (!profile || !key || !id || !id_size)
+		return -EINVAL;
+
+	down_write(&profile->lock);
+	hlist_add_head(&key->hash_node,
+			blk_crypto_hash_bucket_for_id(profile, id, id_size));
+	up_write(&profile->lock);
+
+	return 0;
+}
+
+int blk_crypto_remove_blk_key(struct blk_crypto_profile *profile,
+			const struct blk_crypto_key *key)
+{
+	if (!profile || !key)
+		return -EINVAL;
+
+	down_write(&profile->lock);
+	hlist_del(&key->hash_node);
+	up_write(&profile->lock);
+
+	return 0;
+}
+
+struct blk_crypto_key *
+blk_crypto_find_blk_key(struct blk_crypto_profile *profile,
+						 const u8 *id, const u32 id_size)
+{
+	const struct hlist_head *head;
+	struct blk_crypto_key *key;
+
+	down_read(&profile->lock);
+	head = blk_crypto_hash_bucket_for_id(profile, id, id_size);
+	if (hlist_empty(head)) {
+		pr_err("%s: failed to find the list_head for id: %.*s, id_size: %u.\n",
+			    __func__, id_size, (char *)id, id_size);
+		goto out;
+	}
+
+	hlist_for_each_entry(key, head, hash_node) {
+		up_read(&profile->lock);
+		return key;
+	}
+
+out:
+	up_read(&profile->lock);
+	return NULL;
+}
+#endif /* CONFIG_QCOM_CRYPTO_FDE */
+
 /**
  * blk_crypto_keyslot_index() - Get the index of a keyslot
  * @slot: a keyslot that blk_crypto_get_keyslot() returned
@@ -446,6 +529,9 @@ void blk_crypto_profile_destroy(struct blk_crypto_profile *profile)
 		return;
 	lockdep_unregister_key(&profile->lockdep_key);
 	kvfree(profile->slot_hashtable);
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+	kvfree(profile->key_hashtable);
+#endif
 	kvfree_sensitive(profile->slots,
 			 sizeof(profile->slots[0]) * profile->num_slots);
 	memzero_explicit(profile, sizeof(*profile));
diff --git a/block/blk-crypto.c b/block/blk-crypto.c
index 2270a88e2e4d..d4f006566bb8 100644
--- a/block/blk-crypto.c
+++ b/block/blk-crypto.c
@@ -237,9 +237,40 @@ static bool bio_crypt_check_alignment(struct bio *bio)
 
 blk_status_t __blk_crypto_rq_get_keyslot(struct request *rq)
 {
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+	if (rq->crypt_ctx)
+#endif
 	return blk_crypto_get_keyslot(rq->q->crypto_profile,
 				      rq->crypt_ctx->bc_key,
 				      &rq->crypt_keyslot);
+
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+	blk_status_t ret = BLK_STS_OK;
+	if (is_full_crypto_enabled(rq)) {
+		if (!rq->part->bd_meta_info || !rq->part->bd_meta_info->volname[0])
+			return BLK_STS_NOTSUPP;
+
+		const u32 volname_len = strnlen(rq->part->bd_meta_info->volname,
+										PARTITION_META_INFO_VOLNAMELTH);
+		const struct blk_crypto_key *key =
+						blk_crypto_find_blk_key(rq->q->crypto_profile,
+									rq->part->bd_meta_info->volname,
+									volname_len);
+		if (!key) {
+			pr_err("blk-crypto: Failed to find key for partition %.*s\n",
+					volname_len, rq->part->bd_meta_info->volname);
+			return BLK_STS_NOTSUPP;
+		}
+
+		mutex_lock(&rq->q->crypto_profile->key_mutex);
+		ret = blk_crypto_get_keyslot(rq->q->crypto_profile,
+									  key,
+									  &rq->crypt_keyslot);
+		mutex_unlock(&rq->q->crypto_profile->key_mutex);
+	}
+
+	return ret;
+#endif
 }
 
 void __blk_crypto_rq_put_keyslot(struct request *rq)
@@ -254,8 +285,14 @@ void __blk_crypto_free_request(struct request *rq)
 	if (WARN_ON_ONCE(rq->crypt_keyslot))
 		__blk_crypto_rq_put_keyslot(rq);
 
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+	if (rq->crypt_ctx) {
+#endif
 	mempool_free(rq->crypt_ctx, bio_crypt_ctx_pool);
 	rq->crypt_ctx = NULL;
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+	}
+#endif
 }
 
 /**
@@ -590,11 +627,181 @@ static int blk_crypto_ioctl_prepare_key(struct blk_crypto_profile *profile,
 	return ret;
 }
 
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+static int blk_crypto_ioctl_set_key(struct blk_crypto_profile *profile,
+					  void __user *argp, const unsigned int block_size,
+					  const unsigned int dun_bytes)
+{
+	struct blk_crypto_program_key_arg arg;
+	u8 eph_key[BLK_CRYPTO_MAX_HW_WRAPPED_KEY_SIZE];
+	u8 p_name[PARTITION_META_INFO_VOLNAMELTH];
+	struct blk_crypto_key *bkey = NULL;
+	int ret = 0;
+
+	if (copy_from_user(&arg, argp, sizeof(arg)))
+		return -EFAULT;
+
+	if (memchr_inv(arg.reserved, 0, sizeof(arg.reserved)))
+		return -EINVAL;
+
+	if (arg.eph_key_size > sizeof(eph_key))
+		return -EINVAL;
+
+	if (arg.par_name_len > sizeof(p_name))
+		return -EINVAL;
+
+	if (copy_from_user(eph_key, u64_to_user_ptr(arg.eph_key_ptr),
+			   arg.eph_key_size)) {
+		ret = -EFAULT;
+		goto out;
+	}
+
+	if (copy_from_user(p_name, u64_to_user_ptr(arg.par_name_ptr),
+			arg.par_name_len)) {
+		ret = -EFAULT;
+		goto out;
+	}
+
+	bkey = blk_crypto_find_blk_key(profile, p_name, arg.par_name_len);
+	if (bkey) {
+		pr_warn("%s: The key was already set for %.*s.\n", __func__,
+					 arg.par_name_len, (char *)p_name);
+		ret = -EEXIST;
+		goto out;
+	}
+
+	bkey = kmalloc(sizeof(struct blk_crypto_key), GFP_KERNEL);
+	if (!bkey) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	ret = blk_crypto_init_key(bkey, eph_key, arg.eph_key_size,
+							BLK_CRYPTO_KEY_TYPE_HW_WRAPPED,
+							BLK_ENCRYPTION_MODE_AES_256_XTS,
+							dun_bytes, block_size);
+	if (ret) {
+		pr_err("%s: Init block crypto key failed - ret=%d.\n",
+				__func__, ret);
+		goto fail;
+	}
+
+	if (!__blk_crypto_cfg_supported(profile, &bkey->crypto_cfg)) {
+		ret = -EOPNOTSUPP;
+		goto fail;
+	}
+
+	ret = blk_crypto_add_blk_key(profile, bkey, p_name, arg.par_name_len);
+	if (!ret) {
+		/**
+		 * Once the key is added to the hash table, it can only be removed
+		 * when evicting this key is called.
+		 */
+		goto out;
+	}
+
+fail:
+	kfree_sensitive(bkey);
+	bkey = NULL;
+out:
+	memzero_explicit(eph_key, sizeof(eph_key));
+	memzero_explicit(p_name, sizeof(p_name));
+	return ret;
+}
+
+static int blk_crypto_ioctl_evict_key(struct blk_crypto_profile *profile,
+					  void __user *argp)
+{
+	struct blk_crypto_key *key = NULL;
+	struct blk_crypto_evict_key_arg arg;
+	u8 par_name[PARTITION_META_INFO_VOLNAMELTH];
+	int ret = 0;
+
+	if (copy_from_user(&arg, argp, sizeof(arg)))
+		return -EFAULT;
+
+	if (memchr_inv(arg.reserved, 0, sizeof(arg.reserved)))
+		return -EINVAL;
+
+	if (arg.par_name_len > sizeof(par_name))
+		return -EINVAL;
+
+	if (copy_from_user(par_name, u64_to_user_ptr(arg.par_name_ptr),
+			   arg.par_name_len)) {
+		ret = -EFAULT;
+		goto out;
+	}
+
+	key = blk_crypto_find_blk_key(profile, par_name, arg.par_name_len);
+	if (!key) {
+		/**
+		 * The error only occurs when the key of a given partition is not added
+		 * to the hash table. In this situation, assume the key is never linked
+		 * to the keyslot management structures. So just log it as it should be
+		 * treated as successful.
+		 */
+		pr_warn("%s: Don't find the key for the partition %.*s.\n",
+			    __func__, arg.par_name_len, (char *)par_name);
+		goto out;
+	}
+
+	if (!__blk_crypto_cfg_supported(profile, &key->crypto_cfg)) {
+		ret = -EOPNOTSUPP;
+		goto err;
+	}
+
+	/*
+	 * Even if the key failed to be evicted from a keyslot, the key is still
+	 * unlinked from the keyslot management structures, and the caller is
+	 * allowed and expected to free it right away. There's nothing callers can
+	 * do to handle errors, so just log them and remove the key from the key
+	 * hash table.
+	 */
+	ret = __blk_crypto_evict_key(profile, key);
+	if (ret)
+		pr_warn_ratelimited("%s: error %d evicting key\n", __func__, ret);
+
+err:
+	mutex_lock(&profile->key_mutex);
+	ret = blk_crypto_remove_blk_key(profile, key);
+	if (ret) {
+		pr_err("%s: Failed to remove the key from key hash table.\n",
+				__func__);
+		mutex_unlock(&profile->key_mutex);
+		goto out;
+	}
+	kfree_sensitive(key);
+	key = NULL;
+	mutex_unlock(&profile->key_mutex);
+
+out:
+	memzero_explicit(par_name, sizeof(par_name));
+	return ret;
+}
+
+static unsigned int get_dun_bytes(struct block_device *bdev)
+{
+	unsigned int dun_bytes = 0;
+
+	if (!bdev || !bdev->bd_disk)
+		return dun_bytes;
+
+	if (!strncasecmp(bdev->bd_disk->disk_name, "sd", 2)) {
+		dun_bytes = sizeof(__le64);
+	} else if (!strncasecmp(bdev->bd_disk->disk_name, "mmc", 3) ||
+			   !strncasecmp(bdev->bd_disk->disk_name, "sdhc", 4)) {
+		dun_bytes = sizeof(__le32);
+	}
+
+	return dun_bytes;
+}
+#endif /* CONFIG_QCOM_CRYPTO_FDE */
+
 int blk_crypto_ioctl(struct block_device *bdev, unsigned int cmd,
 		     void __user *argp)
 {
-	struct blk_crypto_profile *profile =
-		bdev_get_queue(bdev)->crypto_profile;
+	struct request_queue *q = bdev_get_queue(bdev);
+	struct blk_crypto_profile *profile = q->crypto_profile;
 
 	if (!profile)
 		return -EOPNOTSUPP;
@@ -606,6 +813,35 @@ int blk_crypto_ioctl(struct block_device *bdev, unsigned int cmd,
 		return blk_crypto_ioctl_generate_key(profile, argp);
 	case BLKCRYPTOPREPAREKEY:
 		return blk_crypto_ioctl_prepare_key(profile, argp);
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+	case BLKCRYPTOPROGRAMKEY:
+		{
+			int ret = -1;
+			const unsigned int blk_size = queue_logical_block_size(q);
+			const unsigned int dun_bytes = get_dun_bytes(bdev);
+
+			if (!dun_bytes) {
+					pr_err("%s: the device (%pg) doesn't support encryption.\n",
+								__func__, bdev);
+					return -EOPNOTSUPP;
+			}
+
+			ret = blk_crypto_ioctl_set_key(profile, argp, blk_size, dun_bytes);
+			if(!ret) {
+				atomic_set(&bdev->crypto_enabled, 1);
+			}
+			return ret;
+		}
+	case BLKCRYPTOEVICTKEY:
+		{
+			int ret = -1;
+			ret = blk_crypto_ioctl_evict_key(profile, argp);
+			if (!ret) {
+				atomic_set(&bdev->crypto_enabled, 0);
+			}
+			return ret;
+		}
+#endif /* CONFIG_QCOM_CRYPTO_FDE */
 	default:
 		return -ENOTTY;
 	}
diff --git a/block/ioctl.c b/block/ioctl.c
index c2a271009da1..1c4eb7a5299b 100644
--- a/block/ioctl.c
+++ b/block/ioctl.c
@@ -563,6 +563,10 @@ static int blkdev_common_ioctl(struct block_device *bdev, blk_mode_t mode,
 	case BLKCRYPTOIMPORTKEY:
 	case BLKCRYPTOGENERATEKEY:
 	case BLKCRYPTOPREPAREKEY:
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+	case BLKCRYPTOPROGRAMKEY:
+	case BLKCRYPTOEVICTKEY:
+#endif
 		return blk_crypto_ioctl(bdev, cmd, argp);
 	case IOC_PR_REGISTER:
 		return blkdev_pr_register(bdev, mode, argp);
diff --git a/drivers/mmc/core/crypto.c b/drivers/mmc/core/crypto.c
index fec4fbf16a5b..68ca239c7d9d 100644
--- a/drivers/mmc/core/crypto.c
+++ b/drivers/mmc/core/crypto.c
@@ -12,6 +12,13 @@
 #include "crypto.h"
 #include "queue.h"
 
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+/**
+ * Logic block size is 4096 bytes, and 512-byte per sector.
+ */
+#define SECTORS_PER_BLOCK 3
+#endif /* CONFIG_QCOM_CRYPTO_FDE */
+
 void mmc_crypto_set_initial_state(struct mmc_host *host)
 {
 	/* Reset might clear all keys, so reprogram all the keys. */
@@ -32,8 +39,16 @@ void mmc_crypto_prepare_req(struct mmc_queue_req *mqrq)
 	struct mmc_request *mrq = &mqrq->brq.mrq;
 	struct blk_crypto_keyslot *keyslot;
 
-	if (!req->crypt_ctx)
+	if (!req->crypt_ctx) {
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+		keyslot = req->crypt_keyslot;
+		if (keyslot) {
+			mrq->crypto_key_slot = blk_crypto_keyslot_index(keyslot);
+			mrq->data_unit_num = blk_rq_pos(req) >> SECTORS_PER_BLOCK;
+		}
+#endif
 		return;
+	}
 
 	mrq->crypto_ctx = req->crypt_ctx;
 
diff --git a/drivers/mmc/host/cqhci-crypto.h b/drivers/mmc/host/cqhci-crypto.h
index d7fb084f563b..f2d4ba8e4b4b 100644
--- a/drivers/mmc/host/cqhci-crypto.h
+++ b/drivers/mmc/host/cqhci-crypto.h
@@ -22,8 +22,15 @@ int cqhci_crypto_init(struct cqhci_host *host);
  */
 static inline u64 cqhci_crypto_prep_task_desc(struct mmc_request *mrq)
 {
-	if (!mrq->crypto_ctx)
+	if (!mrq->crypto_ctx) {
+#ifdef CONFIG_QCOM_CRYPTO_FDE
+			if (mrq->crypto_key_slot != -1)
+				return CQHCI_CRYPTO_ENABLE_BIT |
+					CQHCI_CRYPTO_KEYSLOT(mrq->crypto_key_slot) |
+					mrq->data_unit_num;
+#endif /* CONFIG_QCOM_CRYPTO_FDE */
 		return 0;
+	}
 
