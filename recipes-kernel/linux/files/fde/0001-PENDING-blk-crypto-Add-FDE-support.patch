From 1596f9f6761b3b11ffa6653b0bfc3d16fb9465d8 Mon Sep 17 00:00:00 2001
From: linlzhan <linlzhan@qti.qualcomm.com>
Date: Sat, 6 Dec 2025 19:49:07 +0800
Subject: [PATCH] PENDING: blk-crypto: Add FDE support

Extend block crypto and its profile to support HWKM based FDE.
1. Add ioctls to program and evict hardware-wrapped key.
2. Add hash table mapping between the partition name and its block
   crypto key.
3. Find the block crypto key for the partition enabling FDE, and
   program this key to corresponding key slot before submitting BIO.
4. Caculate DUN based on the start sectors of the request.

Test:
1. The data in the FDE partition is encrypted.
2. FDE partition can only be mounted after enabling FDE.
3. FDE enablement hasn't impact on files with FBE enabled.

Change-Id: I3ba54d3567c62509321ac21a2991529ff331a27b
Signed-off-by: linlzhan <linlzhan@qti.qualcomm.com>
---
 arch/arm64/configs/qcom_defconfig  |   1 +
 block/Kconfig                      |   7 +
 block/bdev.c                       |   3 +
 block/blk-crypto-internal.h        |  27 +++-
 block/blk-crypto-profile.c         |  86 +++++++++++
 block/blk-crypto.c                 | 240 ++++++++++++++++++++++++++++-
 block/ioctl.c                      |   4 +
 drivers/mmc/core/crypto.c          |  17 +-
 drivers/mmc/host/cqhci-crypto.h    |   9 +-
 drivers/ufs/core/ufshcd-crypto.h   |  14 ++
 include/linux/blk-crypto-profile.h |  10 ++
 include/linux/blk-crypto.h         |   3 +
 include/linux/blk_types.h          |   6 +
 include/linux/mmc/core.h           |   5 +-
 include/uapi/linux/blk-crypto.h    |  19 +++
 15 files changed, 445 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/configs/qcom_defconfig b/arch/arm64/configs/qcom_defconfig
index 4b4219051522..17a1683e26d0 100644
--- a/arch/arm64/configs/qcom_defconfig
+++ b/arch/arm64/configs/qcom_defconfig
@@ -836,6 +836,7 @@ CONFIG_CRYPTO_AES_ARM64_CE_CCM=y
 CONFIG_CRYPTO_DEV_QCE=m
 CONFIG_CRYPTO_DEV_QCOM_RNG=m
 CONFIG_CRYPTO_DEV_CCREE=m
+CONFIG_QCOM_CRYPTO_FDE=y
 # CONFIG_HW_RANDOM_ARM_SMCCC_TRNG is not set
 CONFIG_INDIRECT_PIO=y
 CONFIG_TRACE_MMIO_ACCESS=y
diff --git a/block/Kconfig b/block/Kconfig
index f1364d1c0d93..e3494ee592af 100644
--- a/block/Kconfig
+++ b/block/Kconfig
@@ -208,6 +208,13 @@ config BLK_INLINE_ENCRYPTION_FALLBACK
 	  by falling back to the kernel crypto API when inline
 	  encryption hardware is not present.
 
+config QCOM_CRYPTO_FDE
+	bool "Enable full disk encryption support in block layer"
+	depends on BLK_INLINE_ENCRYPTION
+	help
+	  Enabling this lets the block layer handle full disk encryption
+	  for a partition when inline encryption hardware is present.
+
 source "block/partitions/Kconfig"
 
 config BLK_MQ_PCI
diff --git a/block/bdev.c b/block/bdev.c
index 5a54977518ee..8b729af1faa8 100644
--- a/block/bdev.c
+++ b/block/bdev.c
@@ -412,6 +412,9 @@ struct block_device *bdev_alloc(struct gendisk *disk, u8 partno)
 		return NULL;
 	}
 	bdev->bd_disk = disk;
