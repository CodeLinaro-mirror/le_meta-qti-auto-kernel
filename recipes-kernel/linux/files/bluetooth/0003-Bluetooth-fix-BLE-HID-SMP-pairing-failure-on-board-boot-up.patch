From 752b03376e6e5c17dd60299c28564c0755c88cb3 Mon Sep 17 00:00:00 2001
From: Junlin Zhang <junlzhan@qti.qualcomm.com>
Date: Thu, 22 Oct 2026 14:17:23 +0800
Subject: [PATCH] Bluetooth: fix BLE HID SMP pairing failure on board boot-up

If the BT SoC BT_EN is controlled by hardware (e.g. QCA_AUTO_CONVERGED
BT SoC type), commit b369f4fb4304 ("PENDING: driver: bluetooth: hci_qca:
Disable hci_auto_off when BT_EN is consistently pulled up by hardware")
fixed an IBS protocol issue by calling hci_dev_clear_flag(hdev,
HCI_AUTO_OFF) in qca_serdev_probe(). However, this breaks the design
intent of HCI_AUTO_OFF, which was introduced not only as a
power-management mechanism but also as a critical part of the Bluetooth
initialization handshake between the kernel and userspace. Clearing
it in the driver causes hdev_is_powered() to return true prematurely;
bluetoothd receives this state via MGMT_OP_READ_INFO and treats the
controller as already powered, skipping MGMT_OP_SET_POWERED(1) entirely.

HCI_AUTO_OFF is designed to be cleared only when userspace takes
ownership of the controller (e.g. via MGMT_OP_SET_POWERED(1) or the
ioctl open path), which triggers hci_powered_update_sync() ->
smp_register(). When it is cleared prematurely in the driver, bluetoothd
skips MGMT_OP_SET_POWERED(1), smp_register() is never called,
hdev->smp_data remains NULL, conn->smp remains NULL for every new BLE
connection, and any subsequent SMP security request from hog_accept()
fails. This results in BLE HID SMP pairing failure after board boot-up.

Fix this by introducing HCI_QUIRK_NO_AUTO_OFF, which suppresses only the
HCI_AUTO_OFF_TIMEOUT power-off timer without modifying the HCI_AUTO_OFF
flag. This preserves the correct initialization handshake flow while
still preventing HCI from being closed while UART remains open (the
original IBS concern for BT SoC chips where BT_EN is hardware-controlled).

Both hci_power_on() in hci_core.c and hci_power_on_sync() in hci_sync.c
must be updated since they independently schedule the power-off timer.

Fixes: b369f4fb4304 ("PENDING: driver: bluetooth: hci_qca: Disable hci_auto_off when BT_EN is consistently pulled up by hardware")
Change-Id: Ia91b24355ad8e00fd61139a91e8d79a4eb6b45df
Signed-off-by: Junlin Zhang <junlzhan@qti.qualcomm.com>
---
 drivers/bluetooth/hci_qca.c | 14 ++++++++------
 include/net/bluetooth/hci.h | 12 ++++++++++++
 net/bluetooth/hci_core.c    |  3 ++-
 net/bluetooth/hci_sync.c    |  3 ++-
 4 files changed, 24 insertions(+), 8 deletions(-)

diff --git a/drivers/bluetooth/hci_qca.c b/drivers/bluetooth/hci_qca.c
index ce5959f19b11..24b21052a698 100644
--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -2544,12 +2544,14 @@ static int qca_serdev_probe(struct serdev_device *serdev)
 		set_bit(HCI_QUIRK_NON_PERSISTENT_SETUP, &hdev->quirks);
 		hdev->shutdown = qca_power_off;
 	} else {
-	/* host not respond to controller's IBS command
-	 * when BT close hci and no close uart,
-	 * causing controller to enter an abnormal state.
-	 * Therefore, disable HCI_AUTO_OFF
-	 */
-		hci_dev_clear_flag(hdev, HCI_AUTO_OFF);
+		/* For BT SoC where BT_EN is hardware-controlled, the UART cannot
+		 * be closed independently of the physical power supply.
+		 * Closing HCI while leaving UART open causes the IBS (In-Band Sleep)
+		 * state machine to malfunction. Use this quirk to suppress the
+		 * HCI_AUTO_OFF timer without clearing HCI_AUTO_OFF, preserving the
+		 * kernel-userspace initialization handshake.
+		 */
+		set_bit(HCI_QUIRK_NO_AUTO_OFF, &hdev->quirks);
 	}
 
 	if (data) {
diff --git a/include/net/bluetooth/hci.h b/include/net/bluetooth/hci.h
index b25746b91986..9eadc01f1082 100644
--- a/include/net/bluetooth/hci.h
+++ b/include/net/bluetooth/hci.h
@@ -338,6 +338,18 @@ enum {
 	 * claim to support it.
 	 */
 	HCI_QUIRK_BROKEN_READ_ENC_KEY_SIZE,
+
+	/* When this quirk is set, the HCI power off timer (HCI_AUTO_OFF_TIMEOUT)
+	 * that is normally scheduled after controller setup is suppressed.
+	 *
+	 * This is required for BT SoC where BT_EN is hardware-controlled
+	 * and closing HCI while the UART transport remains open causes the
+	 * IBS (In-Band Sleep) state machine to malfunction.
+	 *
+	 * Note: this quirk suppresses only the timer; it does not clear
+	 * HCI_AUTO_OFF.
+	 */
+	HCI_QUIRK_NO_AUTO_OFF,
 };
 
 /* HCI device flags */
diff --git a/net/bluetooth/hci_core.c b/net/bluetooth/hci_core.c
index 824208a53c25..0ac51e498f9b 100644
--- a/net/bluetooth/hci_core.c
+++ b/net/bluetooth/hci_core.c
@@ -968,7 +968,8 @@ static void hci_power_on(struct work_struct *work)
 	     !bacmp(&hdev->static_addr, BDADDR_ANY))) {
 		hci_dev_clear_flag(hdev, HCI_AUTO_OFF);
 		hci_dev_do_close(hdev);
-	} else if (hci_dev_test_flag(hdev, HCI_AUTO_OFF)) {
+	} else if (hci_dev_test_flag(hdev, HCI_AUTO_OFF) &&
+		   !test_bit(HCI_QUIRK_NO_AUTO_OFF, &hdev->quirks)) {
 		queue_delayed_work(hdev->req_workqueue, &hdev->power_off,
 				   HCI_AUTO_OFF_TIMEOUT);
 	}
diff --git a/net/bluetooth/hci_sync.c b/net/bluetooth/hci_sync.c
index 39ab0e42d39a..b7dc4479015e 100644
--- a/net/bluetooth/hci_sync.c
+++ b/net/bluetooth/hci_sync.c
@@ -5399,7 +5399,8 @@ static int hci_power_on_sync(struct hci_dev *hdev)
 	     !bacmp(&hdev->static_addr, BDADDR_ANY))) {
 		hci_dev_clear_flag(hdev, HCI_AUTO_OFF);
 		hci_dev_close_sync(hdev);
-	} else if (hci_dev_test_flag(hdev, HCI_AUTO_OFF)) {
+	} else if (hci_dev_test_flag(hdev, HCI_AUTO_OFF) &&
+		   !test_bit(HCI_QUIRK_NO_AUTO_OFF, &hdev->quirks)) {
 		queue_delayed_work(hdev->req_workqueue, &hdev->power_off,
 				   HCI_AUTO_OFF_TIMEOUT);
 	}
-- 
