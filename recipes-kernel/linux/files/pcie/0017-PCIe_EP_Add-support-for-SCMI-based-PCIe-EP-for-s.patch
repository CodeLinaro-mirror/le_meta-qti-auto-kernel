From 5bb3e61570e344dba58d5245447809002e5150fb Mon Sep 17 00:00:00 2001
From: Nitesh Gupta <nitegupt@qti.qualcomm.com>
Date: Thu, 3 Sep 2026 14:57:43 +0530
Subject: [PATCH 1/1] PCI:qcom:ep Add support for SCMI based PCIe EP for
 sa8797p

Add support for sa8797p for SCMI based Endpoint mode.

Change-Id: I45076499defd7ad4d1b9dfe0f789bf0ded0221e9
Signed-off-by: Nitesh Gupta <nitegupt@qti.qualcomm.com>
---
 drivers/pci/endpoint/functions/pci-epf-mhi.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/pci/endpoint/functions/pci-epf-mhi.c b/drivers/pci/endpoint/functions/pci-epf-mhi.c
index 4dcc69f8e2d7..b7754e6d8670 100644
--- a/drivers/pci/endpoint/functions/pci-epf-mhi.c
+++ b/drivers/pci/endpoint/functions/pci-epf-mhi.c
@@ -157,6 +157,23 @@ static const struct pci_epf_mhi_ep_info sa8797p_info = {
 	.flags = MHI_EPF_USE_DMA,
 };
 
+static struct pci_epf_header sa8787p_header = {
+	.vendorid = PCI_VENDOR_ID_QCOM,
+	.deviceid = 0x012C,
+	.baseclass_code = PCI_CLASS_OTHERS,
+	.interrupt_pin = PCI_INTERRUPT_INTA,
+};
+
+static const struct pci_epf_mhi_ep_info sa8787p_info = {
+	.config = &mhi_v1_config,
+	.epf_header = &sa8787p_header,
+	.bar_num = BAR_1,
+	.epf_flags = PCI_BASE_ADDRESS_MEM_TYPE_32,
+	.msi_count = 32,
+	.mru = 0x8000,
+	.flags = MHI_EPF_USE_DMA,
+};
+
 struct pci_epf_mhi {
 	const struct pci_epc_features *epc_features;
 	const struct pci_epf_mhi_ep_info *info;
@@ -955,6 +972,7 @@ static int pci_epf_mhi_probe(struct pci_epf *epf,
 static const struct pci_epf_device_id pci_epf_mhi_ids[] = {
 	{ .name = "pci_epf_mhi_sa8797p", .driver_data = (kernel_ulong_t)&sa8797p_info },
 	{ .name = "pci_epf_mhi_sa8775p", .driver_data = (kernel_ulong_t)&sa8775p_info },
+	{ .name = "pci_epf_mhi_sa8787p", .driver_data = (kernel_ulong_t)&sa8787p_info },
 	{ .name = "pci_epf_mhi_sdx55", .driver_data = (kernel_ulong_t)&sdx55_info },
 	{ .name = "pci_epf_mhi_sm8450", .driver_data = (kernel_ulong_t)&sm8450_info },
 	{},
-- 
