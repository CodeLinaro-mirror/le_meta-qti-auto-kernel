+
+/**
+ * enum pcie_ecam_log_lvl - severities gated by pcie_ecam_log_level
+ * @PCIE_ECAM_LOG_LVL_ERROR: critical errors, dev_err by default
+ * @PCIE_ECAM_LOG_LVL_INFO: informational messages, dev_info by
+ * default
+ * @PCIE_ECAM_LOG_LVL_DEBUG: verbose diagnostics, dev_dbg by default
+ */
+enum pcie_ecam_log_lvl {
+	PCIE_ECAM_LOG_LVL_ERROR,
+	PCIE_ECAM_LOG_LVL_INFO,
+	PCIE_ECAM_LOG_LVL_DEBUG,
+	PCIE_ECAM_LOG_LVL_MAX,
+};
+
+static int pcie_ecam_log_level = -1;
+
+/**
+ * pcie_ecam_trace_log() - Common trace logging function for this
+ * driver
+ * @level: severity of this call, selects which tracepoint is emitted
+ * @dev: Device pointer
+ * @fmt: Format string
+ * @...: Variable arguments
+ *
+ * Emits the formatted message onto the severity-matched tracepoint
+ * (pcie_ecam_log_error/info/debug). Called by the PCIE_ECAM_*_LOG()
+ * macros in place of dev_err/dev_info/dev_dbg once log_level is
+ * raised past a given message's severity.
+ */
+static void pcie_ecam_trace_log(enum pcie_ecam_log_lvl level,
+				 struct device *dev,
+				 const char *fmt, ...)
+{
+	struct va_format vaf;
+	va_list args;
+
+	va_start(args, fmt);
+	vaf.fmt = fmt;
+	vaf.va = &args;
+
+	switch (level) {
+	case PCIE_ECAM_LOG_LVL_ERROR:
+		trace_pcie_ecam_log_error(dev_name(dev), &vaf);
+		break;
+	case PCIE_ECAM_LOG_LVL_INFO:
+		trace_pcie_ecam_log_info(dev_name(dev), &vaf);
+		break;
+	case PCIE_ECAM_LOG_LVL_DEBUG:
+	default:
+		trace_pcie_ecam_log_debug(dev_name(dev), &vaf);
+		break;
+	}
+
+	va_end(args);
+}
+
+/*
+ * log_fn is substituted back into a directly-invokable logging
+ * macro/function name (dev_err/dev_info/dev_dbg) by preprocessor
+ * rescanning below; it must not be replaced with a function pointer
+ * or wrapper, or the rescan breaks.
+ *
+ * ERROR-severity messages always emit via dev_err() regardless of
+ * pcie_ecam_log_level (in addition to the tracepoint), so raising
+ * log_level only adds dmesg visibility for INFO/DEBUG and never
+ * removes it for errors.
+ */
+#define PCIE_ECAM_LOG(log_fn, level, dev, fmt, ...) do { \
+	if ((level) <= READ_ONCE(pcie_ecam_log_level)) \
+		pcie_ecam_trace_log(level, dev, fmt, ##__VA_ARGS__); \
+	if ((level) == PCIE_ECAM_LOG_LVL_ERROR || \
+	    (level) > READ_ONCE(pcie_ecam_log_level)) \
+		log_fn(dev, fmt, ##__VA_ARGS__); \
+} while (0)
+
+#define PCIE_ECAM_ERR_LOG(level, dev, fmt, ...) \
+	PCIE_ECAM_LOG(dev_err, level, dev, fmt, ##__VA_ARGS__)
+#define PCIE_ECAM_INFO_LOG(level, dev, fmt, ...) \
+	PCIE_ECAM_LOG(dev_info, level, dev, fmt, ##__VA_ARGS__)
+#define PCIE_ECAM_DBG_LOG(level, dev, fmt, ...) \
+	PCIE_ECAM_LOG(dev_dbg, level, dev, fmt, ##__VA_ARGS__)
+
+static ssize_t log_level_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%d\n", READ_ONCE(pcie_ecam_log_level));
+}
+
+static ssize_t log_level_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	int val, old_val;
+
+	if (kstrtoint(buf, 10, &val) != 0 || val < PCIE_ECAM_LOG_LVL_ERROR ||
+	    val >= PCIE_ECAM_LOG_LVL_MAX)
+		return -EINVAL;
+
+	old_val = READ_ONCE(pcie_ecam_log_level);
+	WRITE_ONCE(pcie_ecam_log_level, val);
+	dev_info(dev, "pcie_ecam_log_level changed: %d -> %d\n",
+		old_val, val);
+	return count;
+}
+static DEVICE_ATTR_RW(log_level);
