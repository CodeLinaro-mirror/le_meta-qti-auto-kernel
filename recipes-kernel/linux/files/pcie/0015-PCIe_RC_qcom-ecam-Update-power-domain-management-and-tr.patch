new file mode 100644
index 000000000000..4300c300885a
--- /dev/null
+++ b/include/trace/events/pcie_qcom_ecam.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries. */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM pcie_qcom_ecam
+
+#include <linux/tracepoint.h>
+
+#if !defined(_TRACE_PCIE_QCOM_ECAM_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_PCIE_QCOM_ECAM_H
+
+#define PCIE_ECAM_MAX_MSG_LEN 256
+
+/*
+ * Shared event shape for all severities. pcie_ecam_trace_log() in the driver
+ * picks which of the three DEFINE_EVENT instances below to emit based on the
+ * severity of the PCIE_ECAM_*_LOG() call site, so QLF can enable/filter each
+ * severity independently by event name instead of parsing message text.
+ */
+DECLARE_EVENT_CLASS(pcie_ecam_log_template,
+
+	TP_PROTO(const char *name, struct va_format *vaf),
+
+	TP_ARGS(name, vaf),
+
+	TP_STRUCT__entry(
+		__string(name, name)
+		__dynamic_array(char, msg, PCIE_ECAM_MAX_MSG_LEN)
+	),
+
+	TP_fast_assign(
+		__assign_str_len(name, name, strlen(name));
+		WARN_ON_ONCE(vsnprintf(__get_dynamic_array(msg),
+				       PCIE_ECAM_MAX_MSG_LEN, vaf->fmt,
+				       *vaf->va) >= PCIE_ECAM_MAX_MSG_LEN);
+	),
+
+	TP_printk("%s: %s", __get_str(name), __get_str(msg))
+);
+
+/* Error-level: always enabled by the QLF logging daemon */
+DEFINE_EVENT(pcie_ecam_log_template, pcie_ecam_log_error,
+	TP_PROTO(const char *name, struct va_format *vaf),
+	TP_ARGS(name, vaf));
+
+/* Info-level: disabled by default, enabled on demand */
+DEFINE_EVENT(pcie_ecam_log_template, pcie_ecam_log_info,
+	TP_PROTO(const char *name, struct va_format *vaf),
+	TP_ARGS(name, vaf));
+
+/* Debug-level: disabled by default, enabled only for verbose diagnostics */
+DEFINE_EVENT(pcie_ecam_log_template, pcie_ecam_log_debug,
+	TP_PROTO(const char *name, struct va_format *vaf),
+	TP_ARGS(name, vaf));
+
+#endif /* _TRACE_PCIE_QCOM_ECAM_H */
+
+/* This part must be outside protection */
+#include <trace/define_trace.h>
