-static bool qcom_pcie_check_spurious_int(struct qcom_pcie *pcie)
+/*
+ * Record a safety fault. Must be called with pcie->safety_lock held.
+ *
+ * Note this deliberately does NOT call sysfs_notify(): that takes
+ * kernfs_rwsem and can sleep, which is illegal under the raw spinlock
+ * (and a hard BUG on PREEMPT_RT). Callers accumulate faults and notify
+ * once after dropping the lock.
+ */
+static void qcom_pcie_record_fault(struct qcom_pcie *pcie,
+				   enum qcom_pcie_fault_code code)
+{
+	pcie->pcie_fault[code]++;
+	pcie->pcie_fault_total++;
+}
+
+/* Mask safety sources to stop an interrupt storm. Called under safety_lock. */
+static void qcom_pcie_mask_safety(struct qcom_pcie *pcie, u32 bits)
+{
+	u32 val;
+
+	val = readl(pcie->dbi_base + DBI_SAFETY_MASK_OFF);
+	val |= bits;
+	writel(val, pcie->dbi_base + DBI_SAFETY_MASK_OFF);
+}
+
+/*
+ * Handlers for the individual DBI_SAFETY_STATUS sources.
+ *
+ * These are shared by the aggregated global handler and the dedicated
+ * safety handlers so that both delivery modes behave identically. Each
+ * returns the number of faults recorded. All run under safety_lock.
+ */
+static unsigned int qcom_pcie_handle_rasdp_uncorr(struct qcom_pcie *pcie)
+{
+	dev_err_ratelimited(pcie->dev, "RASDP uncorrectable error triggered");
+	qcom_pcie_record_fault(pcie, RASDP_UNCORR_ERROR);
+
+	/*
+	 * Mask this source together with pcie_uncorr: a RAS-DP uncorrectable
+	 * error keeps the level-triggered safety line asserted and also
+	 * triggers a pcie_uncorr error continuously, so leaving either
+	 * unmasked livelocks the handler.
+	 *
+	 * QNX's safety monitor masks only pcie_uncorr here, not this source's
+	 * own bit — but that is unconfirmed in our own environment, and the
+	 * original crash that started this investigation was traced in part
+	 * to this exact bit being left unmasked. Keep both masked until RASDP
+	 * is shown not to self-recur on our targets. Re-enable via
+	 * qcom_pcie_safety_rearm.
+	 */
+	qcom_pcie_mask_safety(pcie, PCIE_RASDP_UNCORR_ERR | PCIE_AER_UNCORR_ERR);
+
+	return 1;
+}
+
+static unsigned int qcom_pcie_handle_cdm_chk(struct qcom_pcie *pcie)
+{
+	u32 val;
+
+	dev_err_ratelimited(pcie->dev, "CDM error triggered");
+	val = readl(pcie->dbi_base + PCIE_PL_CHK_REG_CONTROL_STATUS);
+	if (!(val & PCIE_PL_CHK_REG_CHK_REG_COMPARISON_ERROR))
+		return 0;
+
+	qcom_pcie_record_fault(pcie, CDM_REG_CHK_ERROR);
+
+	/*
+	 * Clear the latched comparison error. These are write-1-to-clear
+	 * status bits sharing a register with the control bits, so write back
+	 * the observed value masked down to the error bits plus the control
+	 * bits that must stay set. Without this the error stays latched
+	 * forever and every re-arm immediately re-reports it, which makes
+	 * qcom_pcie_safety_rearm useless for this source.
+	 */
+	writel(val & (PCIE_PL_CHK_REG_CHK_REG_COMPARISON_ERROR |
+		      PCIE_PL_CHK_REG_CHK_REG_LOGIC_ERROR |
+		      PCIE_PL_CHK_REG_CHK_REG_CONTINUOUS |
+		      PCIE_PL_CHK_REG_CHK_REG_START),
+	       pcie->dbi_base + PCIE_PL_CHK_REG_CONTROL_STATUS);
+
+	/*
+	 * cdm_chk_err injection results in a continuous interrupt storm
+	 * on certain targets, so masking it.
+	 */
+	qcom_pcie_mask_safety(pcie, PCIE_CDM_CHK_ERR | PCIE_AER_UNCORR_ERR);
+
+	return 1;
+}
+
+/*
+ * OCCAP register checker error.
+ *
+ * Bit 16 reports a register comparison mismatch, bit 17 an error in the
+ * checker logic itself. Both are write-1-to-clear in the same register
+ * that carries the enable, so preserve the control bits when clearing.
+ */
+static unsigned int qcom_pcie_handle_occap_chk(struct qcom_pcie *pcie)
+{
+	u32 val;
+
+	val = readl(pcie->dbi_base + PCIE_PL_OCCAP_CONTROL_STATUS);
+	if (!(val & (PCIE_OCCAP_REG_CHK_ERR | PCIE_OCCAP_REG_CHK_LOGIC_ERR)))
+		return 0;
+
+	dev_err_ratelimited(pcie->dev,
+			    "OCCAP register check error, status:0x%08x%s%s", val,
+			    (val & PCIE_OCCAP_REG_CHK_ERR) ? " compare" : "",
+			    (val & PCIE_OCCAP_REG_CHK_LOGIC_ERR) ? " logic" : "");
+
+	/* Write back the observed error bits to clear them */
+	writel(val & (PCIE_OCCAP_REG_CHK_ERR | PCIE_OCCAP_REG_CHK_LOGIC_ERR),
+	       pcie->dbi_base + PCIE_PL_OCCAP_CONTROL_STATUS);
+
+	qcom_pcie_record_fault(pcie, OCCAP_REG_CHK_ERROR);
+
+	/*
+	 * Mask as for the CDM checker: a persistent register-check mismatch
+	 * would otherwise re-assert continuously.
+	 */
+	qcom_pcie_mask_safety(pcie, PCIE_OCCAP_CHK_ERR | PCIE_AER_UNCORR_ERR);
+
+	return 1;
+}
+
+static unsigned int qcom_pcie_handle_iface_tmr(struct qcom_pcie *pcie)
+{
+	dev_err_ratelimited(pcie->dev, "Iface Timeout error triggered");
+	qcom_pcie_record_fault(pcie, INTERFACE_TIMER_ERROR);
+
+	/*
+	 * interface_timer_err injection results in a continuous interrupt
+	 * storm on certain targets, so masking it.
+	 */
+	qcom_pcie_mask_safety(pcie, PCIE_IFACE_TMR_ERR | PCIE_AER_UNCORR_ERR);
+
+	return 1;
+}
+
+static unsigned int qcom_pcie_handle_rasdp_corr(struct qcom_pcie *pcie)
+{
+	dev_err_ratelimited(pcie->dev, "RASDP correctable error triggered");
+	qcom_pcie_record_fault(pcie, RASDP_CORR_ERROR);
+
