+		struct device_attribute *attr,
+		const char *buf, size_t count)
+{
+	struct qcom_pcie *pcie = (struct qcom_pcie *)dev_get_drvdata(dev);
+	unsigned long irqsave_flags;
+	unsigned long val;
+	int ret;
+	u32 reg;
+
+	ret = kstrtoul(buf, 10, &val);
+	if (ret)
+		return ret;
+
+	if (val != 1) {
+		dev_err(dev, "Invalid value. Write '1' to re-arm safety interrupts\n");
+		return -EINVAL;
+	}
+
+	/* Serialize against init/deinit/reset operations */
+	if (!mutex_trylock(&pcie->reset_lock)) {
+		dev_warn(dev, "Another init/deinit/reset operation in progress, please wait\n");
+		return -EBUSY;
+	}
+
