 {
-	u32 val, mask;
-
-	/* Clear all the interrupts before we enable it */
 	writel(0, pcie->dbi_base + DBI_SAFETY_STATUS);
 	writel(0, pcie->dbi_base + DBI_INTERFACE_TIMER_STATUS);
 
-	/* Clear interrupts which are aggregated using GLOBAL_INT */
 	writel(CFGPCIE_INT_ALL_STATUS_MASK, pcie->parf + PARF_INT_ALL_CLEAR);
 	writel(CFGPCIE_PARF_INT_STATUS_MASK, pcie->parf + PARF_INT_CLEAR);
 	writel(CFGPCIE_INT_ALL_2_STATUS_MASK,
@@ -838,6 +849,14 @@ static void qcom_pcie_enable_error_reporting(struct qcom_pcie *pcie)
 		pcie->parf + PARF_INT_ALL_4_CLEAR);
 	writel(CFGPCIE_INT_ALL_5_STATUS_MASK,
 		pcie->parf + PARF_INT_ALL_5_CLEAR);
+}
+
+static void qcom_pcie_enable_error_reporting(struct qcom_pcie *pcie)
+{
+	u32 val, mask;
+
+	/* Clear all the interrupts before we enable it */
+	qcom_pcie_clear_safety_interrupts(pcie);
 
 	/* Enable DBI writes
 	 * Enable SERR generation
@@ -1071,6 +1090,7 @@ static irqreturn_t qcom_pcie_global_irq_thread(int irq, void *data)
 	 * finish our register access before deinit's teardown can start.
 	 */
 	if (!pcie->pci_host_initialized) {
+		bool requested = pcie->global_irq_requested;
 		raw_spin_unlock_irqrestore(&pcie->safety_lock, irqsave_flags);
 		/*
 		 * No PCIE_ECAM_LOG_LVL_WARN tier exists, so this ratelimited
@@ -1164,7 +1184,7 @@ static int qcom_pcie_init_power_domains(struct qcom_pcie *pcie)
 	if (pcie->power_enabled)
 		return 0;
 
-	/* No power domain in DT — optional, nothing to manage */
+	/* No power domain in DT - optional, nothing to manage */
 	if (!dev->pm_domain)
 		return 0;
 
@@ -1195,7 +1215,7 @@ static int qcom_pcie_init_power_domains(struct qcom_pcie *pcie)
  *
  * Calls pm_runtime_put_sync() on pdev->dev to balance the
  * pm_runtime_resume_and_get() from init.  Does NOT call
- * dev_pm_domain_detach() — platform_drv_probe() owns the attachment
+ * dev_pm_domain_detach() - platform_drv_probe() owns the attachment
  * and
  * platform_remove() will detach it on driver removal.
  *
@@ -1242,143 +1262,6 @@ static void qcom_pcie_ecam_free_action(void *data)
 		pci_ecam_free(cfg);
 }
 
