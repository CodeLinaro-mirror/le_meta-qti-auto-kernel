From 08679d58371af7ab28c467769d2b85339756e282 Mon Sep 17 00:00:00 2001
From: Aniket Randive <quic_arandive@quicinc.com>
Date: Fri, 25 Oct 2024 14:09:06 +0530
Subject: [PATCH 2/2] PENDING: i2c: i2c-qcom-geni:  Add compatible field for
 SA8797P

Add compatible field for I2C driver for SA8797P.

Change-Id: I03141081ace38617593d6fea8756f11fa2d71c5f
Signed-off-by: Aniket Randive <quic_arandive@quicinc.com>
---
 drivers/i2c/busses/i2c-qcom-geni.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/i2c/busses/i2c-qcom-geni.c b/drivers/i2c/busses/i2c-qcom-geni.c
index d006606c5572..41a251f0d3b1 100644
--- a/drivers/i2c/busses/i2c-qcom-geni.c
+++ b/drivers/i2c/busses/i2c-qcom-geni.c
@@ -902,7 +902,8 @@ static int geni_i2c_probe(struct platform_device *pdev)

 	gi2c->dev_data = desc;

-	if (of_device_is_compatible(dev->of_node, "qcom,sa8775p-geni-i2c")) {
+	if (of_device_is_compatible(dev->of_node, "qcom,sa8775p-geni-i2c") ||
+		of_device_is_compatible(dev->of_node, "qcom,sa8797p-geni-i2c")) {
 		ret = dev_pm_domain_attach_list(&pdev->dev, &gi2c->dev_data->pd_data,
 						&gi2c->se.pd_list);
 		if (ret < 0)
@@ -1175,6 +1176,7 @@ static const struct of_device_id geni_i2c_dt_match[] = {
 	{ .compatible = "qcom,geni-i2c", .data = &geni_i2c },
 	{ .compatible = "qcom,geni-i2c-master-hub", .data = &i2c_master_hub },
 	{ .compatible = "qcom,sa8775p-geni-i2c", .data = &remotely_geni_i2c },
+	{ .compatible = "qcom,sa8797p-geni-i2c", .data = &remotely_geni_i2c },
 	{}
 };
 MODULE_DEVICE_TABLE(of, geni_i2c_dt_match);
--
2.17.1

