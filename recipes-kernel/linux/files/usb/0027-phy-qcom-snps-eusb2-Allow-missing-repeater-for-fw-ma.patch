From 5297be905b4593ad7620faf0c93e8ecc706bc8f4 Mon Sep 17 00:00:00 2001
From: Lei Wang <leiwan@qti.qualcomm.com>
Date: Thu, 10 Jul 2026 00:00:00 +0000
Subject: [PATCH] phy: qcom-snps-eusb2: Allow missing repeater for fw-managed PHYs

On sa8797p, usb_1_eusbphy (0x88eb000) and usb_2_eusbphy (0x88e0000)
are fw-managed PHYs that have no eUSB2 repeater on the board and no
'phys' property in DT. The driver unconditionally calls
devm_of_phy_get_by_index() and fails with -ENODEV, keeping the DWC3
controllers at 0xa400000 and 0xa200000 stuck in deferred probe.

Allow fw-managed PHYs to probe successfully when no repeater is present
in DT by treating -ENODEV as optional for that compatible. Guard all
repeater call sites (set_mode, init, exit) against a NULL pointer.

Non-fw-managed PHYs continue to require a repeater and fail hard on
-ENODEV as before.

Signed-off-by: Lei Wang <leiwan@qti.qualcomm.com>
---
 drivers/phy/qualcomm/phy-qcom-snps-eusb2.c | 18 +++++++++++++-----
 1 file changed, 13 insertions(+), 5 deletions(-)

diff --git a/drivers/phy/qualcomm/phy-qcom-snps-eusb2.c b/drivers/phy/qualcomm/phy-qcom-snps-eusb2.c
index 1484691a41d5..ea8c5ea66d2d 100644
--- a/drivers/phy/qualcomm/phy-qcom-snps-eusb2.c
+++ b/drivers/phy/qualcomm/phy-qcom-snps-eusb2.c
@@ -202,7 +202,9 @@ static int qcom_snps_eusb2_hsphy_set_mode(struct phy *p, enum phy_mode mode, in

 	phy->mode = mode;

-	return phy_set_mode_ext(phy->repeater, mode, submode);
+	if (phy->repeater)
+		return phy_set_mode_ext(phy->repeater, mode, submode);
+	return 0;
 }

 static void qcom_snps_eusb2_hsphy_write_mask(void __iomem *base, u32 offset,
@@ -339,10 +341,14 @@ static int qcom_snps_eusb2_hsphy_init(struct phy *p)
 	} else {
-		ret = phy_init(phy->repeater);
-		if (ret) {
-			dev_err(&p->dev, "repeater init failed. %d\n", ret);
-			qcom_snps_d0_to_d3(phy);
-			return ret;
+		if (phy->repeater) {
+			ret = phy_init(phy->repeater);
+			if (ret) {
+				dev_err(&p->dev, "repeater init failed. %d\n", ret);
+				qcom_snps_d0_to_d3(phy);
+				return ret;
+			}
 		}
 	}

@@ -456,7 +462,9 @@ static int qcom_snps_eusb2_hsphy_exit(struct phy *p)
 	}
-	phy_exit(phy->repeater);
+	if (phy->repeater)
+		phy_exit(phy->repeater);
 	return 0;
 }

@@ -577,9 +585,11 @@ static int qcom_snps_eusb2_hsphy_probe(struct platform_device *pdev)

 	phy->repeater = devm_of_phy_get_by_index(dev, np, 0);
-	if (IS_ERR(phy->repeater)) {
-		qcom_snps_domain_detach(phy);
-		return dev_err_probe(dev, PTR_ERR(phy->repeater),
-				     "failed to get repeater\n");
+	if (IS_ERR(phy->repeater)) {
+		if (PTR_ERR(phy->repeater) != -ENODEV || !phy->fw_managed) {
+			qcom_snps_domain_detach(phy);
+			return dev_err_probe(dev, PTR_ERR(phy->repeater),
+					     "failed to get repeater\n");
+		}
+		phy->repeater = NULL;
 	}

 	generic_phy = devm_phy_create(dev, NULL, &qcom_snps_eusb2_hsphy_ops);
