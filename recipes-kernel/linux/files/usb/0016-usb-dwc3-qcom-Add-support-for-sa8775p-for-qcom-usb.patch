From 75e39cdc9cdca18a9a7d62346522fd88ec7a4fc6 Mon Sep 17 00:00:00 2001
From: Faisal Hassan <quic_faisalh@quicinc.com>
Date: Mon, 17 Mar 2025 16:57:05 +0530
Subject: [PATCH] usb: dwc3: qcom: Add support for sa8797p for qcom usb

QCOM SoC sa8797p allow multiple resources to be managed
by firmware. On this platform, tasks related to clocks, regulators,
resets, TLMM and interconnects can be delegated to the firmware,
while the remaining responsibilities are handled by Linux.

The power domain, managed through the PM runtime framework,
is utilized for activation/deactivation of the resources.

Power domain "usb_core" controls the GDSC, resets,
and TLMM(gpio) whereas power domain "usb_transfer"
controls clocks and interconnects.

In this variant, the two disjoint sets of resources are modeled against
the power domain suppliers which can be turned on/off to achieve modeled
device states. Two modeled low power states d1 and d3 are supported.

transition: d0 <--> d3  :: both core and transfer suppliers
transition: d0 <--> d1  :: only transfer supplier

Change-Id: If0b4602bbedffdee07550e74a24edf35ca616d63
Signed-off-by: Sriram Dash <quic_sriramd@quicinc.com>
Signed-off-by: Hiren Gohel <quic_vhiren@quicinc.com>
Signed-off-by: Faisal Hassan <quic_faisalh@quicinc.com>
Signed-off-by: Shazad Hussain <quic_shazhuss@quicinc.com>
---
 drivers/usb/dwc3/dwc3-qcom.c | 33 +++++++++++++++++----------------
 1 file changed, 17 insertions(+), 16 deletions(-)

diff --git a/drivers/usb/dwc3/dwc3-qcom.c b/drivers/usb/dwc3/dwc3-qcom.c
index dddc9a711d94..3144202e8919 100644
--- a/drivers/usb/dwc3/dwc3-qcom.c
+++ b/drivers/usb/dwc3/dwc3-qcom.c
@@ -109,10 +109,6 @@ struct dwc3_qcom {
 	struct dev_pm_domain_list	*pd_list;
 };
 
-static const struct dwc3_qcom_priv_data sa8255p_dwc3_qcom_priv_data = {
-	.fw_managed	= true,
-};
-
 static void dwc3_qcom_domain_detach(struct dwc3_qcom *qcom)
 {
 	dev_pm_domain_detach_list(qcom->pd_list);
@@ -122,11 +118,11 @@ static int dwc3_qcom_domain_attach(struct dwc3_qcom *qcom)
 {
 	struct dev_pm_domain_attach_data pd_data = {
 		.pd_flags	= PD_FLAG_NO_DEV_LINK,
-		.pd_names	= (const char*[]) { "usb_transfer", "usb_core" },
+		.pd_names	= (const char*[]) { "transfer", "core" },
 		.num_pd_names	= 2,
 	};
 	struct device *dev = qcom->dev;
-	int ret = 0;
+	int ret;
 
 	ret = dev_pm_domain_attach_list(dev, &pd_data, &qcom->pd_list);
 	if (ret < 0) {
@@ -140,16 +136,16 @@ static int dwc3_qcom_domain_attach(struct dwc3_qcom *qcom)
 /* d3_to_d0 transition by turning on all the suppliers */
 static int dwc3_qcom_d3_to_d0(struct dwc3_qcom *qcom)
 {
-	int ret = 0;
+	int ret;
 
 	if (!qcom->pd_list)
 		return 0;
 
-	ret = pm_runtime_resume_and_get(qcom->pd_list->pd_devs[0]);
+	ret = pm_runtime_resume_and_get(qcom->pd_list->pd_devs[1]);
 	if (ret)
 		return ret;
 
-	ret = pm_runtime_resume_and_get(qcom->pd_list->pd_devs[1]);
+	ret = pm_runtime_resume_and_get(qcom->pd_list->pd_devs[0]);
 
 	return ret;
 }
@@ -173,7 +169,7 @@ static int dwc3_qcom_d1_to_d0(struct dwc3_qcom *qcom)
 	return pm_runtime_resume_and_get(qcom->pd_list->pd_devs[0]);
 }
 
-/* d0_to_d1 transition by turning off the 'tranfer' supplier */
+/* d0_to_d1 transition by turning off the 'transfer' supplier */
 static void dwc3_qcom_d0_to_d1(struct dwc3_qcom *qcom)
 {
 	if (!qcom->pd_list)
@@ -1161,6 +1157,7 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 	struct resource		*res, *parent_res = NULL;
 	struct resource		local_res;
 	int			ret, i;
+	bool			fw_managed;
 	bool			wakeup_source;
 	bool			legacy_binding;
 
@@ -1168,8 +1165,6 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 	if (!qcom)
 		return -ENOMEM;
 
-	priv_data = of_device_get_match_data(dev);
-
 	legacy_binding = dwc3_qcom_has_separate_dwc3_of_node(dev);
 
 	if (!legacy_binding)
@@ -1184,7 +1179,10 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
-	if (priv_data && priv_data->fw_managed) {
+	fw_managed = device_get_match_data(dev);
+	dev_err(dev, "fw_managed=%s\n", fw_managed ? "true" : "false");
+	fw_managed = true;
+	if (fw_managed) {
 		ret = dwc3_qcom_domain_attach(qcom);
 		if (ret) {
 			dev_err(dev, "Failed to attach domains. Bail out\n");
@@ -1342,12 +1340,12 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 	}
 reset_assert:
 	reset_control_assert(qcom->resets);
-
 resources_off:
 	dwc3_qcom_d0_to_d3(qcom);
 
 domain_detach:
 	dwc3_qcom_domain_detach(qcom);
+
 	return ret;
 }
 
@@ -1535,13 +1533,16 @@ static const struct dev_pm_ops dwc3_qcom_dev_pm_ops = {
 };
 
 static const struct of_device_id dwc3_qcom_of_match[] = {
+	{	.compatible	= "qcom,sa8797p-dwc3",
+		.data		= (void *)true,
+	},
 	{
 		.compatible	= "qcom,sa7255p-dwc3",
-		.data		= &sa8255p_dwc3_qcom_priv_data,
+		.data		= (void *)true,
 	},
 	{
 		.compatible	= "qcom,sa8255p-dwc3",
-		.data		= &sa8255p_dwc3_qcom_priv_data,
+		.data		= (void *)true,
 	},
 	{ .compatible = "qcom,dwc3" },
 	{ }
-- 
