From: Lei Wang <leiwan@qti.qualcomm.com>
Date: Mon, 04 Aug 2026 00:00:00 +0000
Subject: [PATCH] PENDING: firmware: arm_scmi: serialize PCIe power domain
 transitions

The 4 PCIe ECAM root complexes each sit on an independent SCMI channel.
During boot, genpd_sync_power_on() is called for all 4 controllers
nearly simultaneously, issuing concurrent power state_set() requests
on separate firmware channels. The firmware PCIe power handler is not
re-entrant across channels and crashes under this concurrency
(use-after-free, freed-memory pattern 0xaaaaaaaa in the fault
registers).

Add a mutex around the SCMI state_set/state_get sequence, but scope it
to PCIe power domains only (identified by "pcie" substring in the
firmware-provided domain name, e.g. 'scmi-power-pcie0-domain0').
This avoids serializing unrelated power domains and limits the
performance impact to PCIe transitions only.

Signed-off-by: Lei Wang <leiwan@qti.qualcomm.com>
---
 drivers/firmware/arm_scmi/scmi_pm_domain.c | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/drivers/firmware/arm_scmi/scmi_pm_domain.c b/drivers/firmware/arm_scmi/scmi_pm_domain.c
--- a/drivers/firmware/arm_scmi/scmi_pm_domain.c
+++ b/drivers/firmware/arm_scmi/scmi_pm_domain.c
@@ -8,11 +8,20 @@
 #include <linux/err.h>
 #include <linux/io.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/pm_domain.h>
 #include <linux/scmi_protocol.h>
+#include <linux/string.h>

 static const struct scmi_power_proto_ops *power_ops;

+/*
+ * Serializes SCMI power-on/off requests for PCIe domains only.
+ * The 4 PCIe RCs sit on independent SCMI channels; concurrent requests
+ * from genpd_sync_power_on() during boot trigger a firmware crash.
+ */
+static DEFINE_MUTEX(scmi_pd_power_lock);
+
 struct scmi_pm_domain {
 	struct generic_pm_domain genpd;
 	const struct scmi_protocol_handle *ph;
@@ -27,17 +36,22 @@
 	int ret;
 	u32 state, ret_state;
 	struct scmi_pm_domain *pd = to_scmi_pd(domain);
+	bool is_pcie = pd->name && strstr(pd->name, "pcie");

 	if (power_on)
 		state = SCMI_POWER_STATE_GENERIC_ON;
 	else
 		state = SCMI_POWER_STATE_GENERIC_OFF;

+	if (is_pcie)
+		mutex_lock(&scmi_pd_power_lock);
 	ret = power_ops->state_set(pd->ph, pd->domain, state);
 	if (!ret)
 		ret = power_ops->state_get(pd->ph, pd->domain, &ret_state);
 	if (!ret && state != ret_state)
-		return -EIO;
+		ret = -EIO;
+	if (is_pcie)
+		mutex_unlock(&scmi_pd_power_lock);

 	return ret;
 }
--
2.x.x
