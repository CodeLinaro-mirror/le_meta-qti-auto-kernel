From 8f2398975b01e8809d63d3acad4a628213544359 Mon Sep 17 00:00:00 2001
From: Aniket Randive <quic_arandive@quicinc.com>
Date: Fri, 25 Oct 2024 12:25:01 +0530
Subject: [PATCH 1/2] PENDING: spi: spi-geni-qcom: Add compatible field for
 SA8797P

Add compatible field for SPI driver for SA8797P.

Change-Id: I276e1c4c07a6833acf23b407d219839d9a83bb2b
Signed-off-by: Aniket Randive <quic_arandive@quicinc.com>
---
 drivers/spi/spi-geni-qcom.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)
 
diff --git a/drivers/spi/spi-geni-qcom.c b/drivers/spi/spi-geni-qcom.c
index e80ef90e98aa..df6aeea542e8 100644
--- a/drivers/spi/spi-geni-qcom.c
+++ b/drivers/spi/spi-geni-qcom.c
@@ -1206,8 +1206,9 @@ static int spi_geni_probe(struct platform_device *pdev)
 	if (!mas->dev_data)
 		return -ENXIO;

-	if (of_device_is_compatible(dev->of_node, "qcom,sa8775p-geni-spi")) {
-		ret = dev_pm_domain_attach_list(&pdev->dev, &mas->dev_data->pd_data,
+	if (of_device_is_compatible(dev->of_node, "qcom,sa8775p-geni-spi") ||
+		of_device_is_compatible(dev->of_node, "qcom,sa8797p-geni-spi")) {
+			ret = dev_pm_domain_attach_list(&pdev->dev, &mas->dev_data->pd_data,
 						&mas->se.pd_list);
 		if (ret < 0)
 			return ret;
@@ -1412,6 +1413,7 @@ static const struct geni_spi_desc remotely_geni_spi = {
 static const struct of_device_id spi_geni_dt_match[] = {
 	{ .compatible = "qcom,geni-spi", .data = &geni_spi },
 	{ .compatible = "qcom,sa8775p-geni-spi", .data = &remotely_geni_spi },
+	{ .compatible = "qcom,sa8797p-geni-spi", .data = &remotely_geni_spi },
 	{}
 };
 MODULE_DEVICE_TABLE(of, spi_geni_dt_match);
--
2.17.1

