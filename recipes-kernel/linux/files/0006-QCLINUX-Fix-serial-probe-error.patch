From 2275dda8e5d6034dce41d41d787b1ff5ceb4265d Mon Sep 17 00:00:00 2001
From: Kaisheng Yang <quic_kaisheng@quicinc.com>
Date: Sat, 31 Aug 2024 16:41:27 +0800
Subject: [PATCH] QCLINUX: Fix serial probe error

Change-Id: Id6bd3cd9fedde8e94735c43840a47ddbd5a0eaa9
Signed-off-by: Kaisheng Yang <quic_kaisheng@quicinc.com>
---
 drivers/tty/serial/qcom_geni_serial.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/tty/serial/qcom_geni_serial.c b/drivers/tty/serial/qcom_geni_serial.c
index a41228ed8f61..6941ac2d0773 100644
--- a/drivers/tty/serial/qcom_geni_serial.c
+++ b/drivers/tty/serial/qcom_geni_serial.c
@@ -1329,6 +1329,8 @@ static int geni_serial_set_level(struct geni_se *se, unsigned long baud)
 	if (!perf_dev)
 		return -ENODEV;
 
+	return 0;
+
 	ret = dev_pm_opp_set_level(perf_dev, baud);
 	if (ret)
 		dev_err(se->dev, "performance operation(%d) failed with err=%d\n",
-- 
2.17.1

